{
  "name": "inyo-rebuilt",
  "private": true,
  "version": "1.0.0",
  "description": "Local clone of joininyo.com (Framer published site) for visual edits",
  "scripts": {
    "dev": "npm run exact",
    "exact": "npx --yes serve exact -l 5173 --no-clipboard",
    "editable": "npm --prefix editable run dev -- --port 5174",
    "original": "npx --yes serve original -l 5175 --no-clipboard",
    "start": "npm run exact",
    "compare": "npx --yes serve comparisons -l 5176 --no-clipboard",
    "capture-compare": "node comparisons/capture_all.mjs",
    "doc": "python3 comparisons/build_google_doc.py",
    "pdf": "python3 comparisons/compose_pdf_canvas.py"
  }
}
